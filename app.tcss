Screen {
    background: $surface;
}

#search {
    dock: top;
    margin: 1 2 0 2;
    border: tall $accent;
}

#body {
    height: 1fr;
    padding: 1 2;
}

#results {
    width: 34%;
    min-width: 26;
    margin-right: 1;
    padding: 0 1;
    border: round $primary;
    background: $panel;
}

#results > ListItem {
    padding: 0 1;
}

#right {
    width: 1fr;
}

#poster {
    height: 40%;
    min-height: 6;
    margin-bottom: 1;
    padding: 0 1;
    border: round $primary;
    background: $panel;
    align: center middle;
}

#detail {
    height: 1fr;
    padding: 0 1;
    border: round $primary;
    background: $panel;
}
