Screen {
    background: $surface;
}

#search {
    margin: 1 2 0 2;
    border: tall $accent;
}

#tabs {
    margin: 0 2;
}

#body {
    height: 1fr;
    padding: 0 2 1 2;
}

#left {
    width: 34%;
    min-width: 28;
    margin-right: 1;
}

#controls {
    height: auto;
    margin-bottom: 1;
}

#controls Select {
    width: 1fr;
    margin-right: 1;
}

#results {
    height: 1fr;
    padding: 0 1;
    border: round $primary;
    background: $panel;
}

#results > ListItem {
    padding: 0 1;
}

#right {
    width: 1fr;
}

#poster {
    height: 55%;
    min-height: 8;
    margin-bottom: 1;
    padding: 0 1;
    border: round $primary;
    background: $panel;
    align: center middle;
}

#info {
    height: 1fr;
}

#info ContentSwitcher {
    height: 1fr;
    border: round $primary;
    background: $panel;
}

#detail, #reviews {
    height: 1fr;
    padding: 0 1;
    background: $panel;
}

#cast {
    height: 1fr;
    padding: 0 1;
    background: $panel;
}

#cast > ListItem {
    padding: 0 1;
}

#episodes {
    height: 1fr;
    padding: 0 1;
    background: $panel;
}

#episodes #season {
    margin-bottom: 1;
}

#filters {
    height: auto;
    margin-bottom: 1;
}

#filters Select {
    width: 1fr;
    margin-right: 1;
}

#stats {
    height: 1fr;
    padding: 0 1;
    background: $panel;
}
