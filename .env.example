# TMDB — https://www.themoviedb.org/settings/api  (free, instant)
# Use EITHER the v3 API key OR the v4 read access token. Token wins if both set.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# OMDb — https://www.omdbapi.com/apikey.aspx  (free tier, 1000 req/day)
# Supplies the IMDb / Rotten Tomatoes / Metacritic score line. Optional.
OMDB_API_KEY=

# Optional overrides
# MOVIETERM_CACHE_DIR=~/.cache/movieterm
# MOVIETERM_CACHE_TTL=604800
# MOVIETERM_POSTER_SIZE=w342