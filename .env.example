# TMDB — https://www.themoviedb.org/settings/api  (free, instant)
# Use EITHER the v3 API key OR the v4 read access token. Token wins if both set.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# OMDb — https://www.omdbapi.com/apikey.aspx  (free tier, 1000 req/day)
# Supplies the IMDb / Rotten Tomatoes / Metacritic score line. Optional.
OMDB_API_KEY=

# Optional overrides
# COLOMBUS_CACHE_DIR=~/.cache/colombus
# COLOMBUS_CACHE_TTL=604800
# COLOMBUS_POSTER_SIZE=w342
# Connection retries when a TMDB handshake fails (default 3)
# COLOMBUS_HTTP_RETRIES=3
# Poster backend: auto | tgp | sixel | halfcell | unicode | ascii | braille | none
# ascii and braille are character art and need no terminal graphics support
# Set this if posters do not appear in your terminal
# COLOMBUS_POSTER_PROTOCOL=halfcell